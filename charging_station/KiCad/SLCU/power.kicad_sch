	(text_box "Power requirements:\n\nStack Light (24V):\nI = 0.06A à 24V => P = 1.44W\n\n\nLEDs (12V):\n4x Relais\n6x GPIO\n7x Logic Status\n2x Power\n-------------\n19 LEDs à ~10mA => I < 200mA (12V) => P = 2.4W\n         à ~15mA => I < 300mA (12V) => P = 3.6W\n\nLogic ICs (neglectable)(12V):\n	P_{sum} < 1mW\n\nMosfets (12V):\n1x Inverters:\n	à I = 12V / 47k = @{round(12/47, 3)}mA\n	à P = @{round(12*12/47, 3)}mW\n16x Gate Drive (absolute) Peak current:\n	9x Logic\n	7x GPIO\n	(3*2)x Stack Light drive\n	à I = 12V / 1k = @{round(12/1, 3)}mA => I_{sum} = @{round(22 * 12/1, 3)}mA\n	à P = @{round(12*12/1, 3)}mW => P_{sum} = @{round(22 * 12*12/1000, 2)}W\n\n-----------------------------------\nTOTAL:\n	I_{12V)TOTAL} = @{round(0.3 + (1 * 12/47000) + (22 * 12/1000), 3)} A\n	P_{12V)TOTAL} = @{round(3.6 + (1 * 12*12/47000) + (22 * 12*12/1000), 3)} W"
		(exclude_from_sim no)
		(at 38.1 91.44 0)
		(size 62.23 69.3764)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "98e58818-a8a7-40ed-b9b9-a76ecc477d5e")
	)
