	)
	(text_box "LEDs (12V):\n4x (4 Red) external Relais\n6x (2 Green + 2 Yellow + 2 Red) GPIO\n7x (3 Green + 4 Red) Logic Status\n1x (1 Green) Power\n\n------------------------------\n\n=> 6x GREEN		= @{format(6 * 0.30, 2)}mA @ @{format(6 * 12 * 0.30, 2)}mW\n=> 2x YELLOW	= @{format(2 * 5.00, 2)}mA @ @{format(2 * 12 * 5.00, 2)}mW\n=> 10x RED		= @{format(10 * 2.15, 2)}mA @ @{format(10 * 12 * 2.15, 2)}mW\n------------------------------\n==> Total		= @{format((6 * 0.30) + (2 * 5.00) + (10 * 2.15), 2)}mA @ @{format(12 * ((6 * 0.30) + (2 * 5.00) + (10 * 2.15)), 2)}mW"
		(exclude_from_sim no)
		(at 27.94 72.39 0)
		(size 62.23 29.21)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c8017664-5385-480a-b8d9-69191d2d7b53")
	)
	(text_box "Mosfets, Pulldowns(PD), Voltage diviers(VD), Gate Resistors(GR) etc. (12V):\n4x 33k PDs 		=> @{format(4 * 12/33, 2)}mA @ @{format(4 * 12^2/33, 2)}mW\n2x 4k7/4k7 VDs	=> @{format(2 * 12/(2*4.7), 2)}mA @ @{format(2 * 12^2/(2*4.7), 2)}mW\n(1x 4k7 PD		=> @{format(12/4.7, 2)}mA @ @{format(12^2/4.7, 2)}mW)(VD gets PD)\n6x 4k7 PDs		=> @{format(6 * 12/4.7, 2)}mA @ @{format(6 * 12^2/4.7, 2)}mW\n------------------------------\nTotal 			=> @{format((4 * 12/33) + (2 * 12/(2*4.7)) + (12/4.7) + (6 * 12/4.7), 2)}mA @ @{format(12*((4 * 12/33) + (2 * 12/(2*4.7)) + (12/4.7) + (6 * 12/4.7)), 2)}mW\n\n\n1x 2k7 GR		=> @{format(12/2.7, 2)}mA @ @{format(12^2/2.7, 2)}mW\n13x 4k7 GRs		=> (@{format(13 * 12/4.7, 2)}mA @ @{format(13 * 12^2/4.7, 2)}mW)\n-> only transiently, never all MOSFETs at same time\n-> realistically at most 8 transients at once\n=> 7x4k7+1x2k7 GRs => (@{format(12 * (7/4.7 + 1/2.7), 2)}mA @ @{format(12^2 * (7/4.7 + 1/2.7), 2)}mW)\n\n------------------------------\n\nTotal_{+Transient} => @{format((4 * 12/33) + (2 * 12/(2*4.7)) + (6 * 12/4.7) + 12 * (7/4.7 + 1/2.7), 2)}mA @ @{format(12*((4 * 12/33) + (2 * 12/(2*4.7)) + (6 * 12/4.7) + 12 * (7/4.7 + 1/2.7)), 2)}mW"
		(exclude_from_sim no)
		(at 27.94 121.92 0)
		(size 62.23 41.91)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ddaa7e97-2b41-4413-846a-5209d74bfe98")
	)
	(text_box "LED Power specification (take from Logic Multiplexing Page):\nLED: Current, power\nGREEN:	0.30mA, @{format(12 * 0.30, 2)}mW\nYELLOW:	5.00mA, @{format(12 * 5.00, 2)}mW\nRED:	2.15mA, @{format(12 * 2.15, 2)}mW\n"
		(exclude_from_sim no)
