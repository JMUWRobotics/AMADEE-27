	(text "I_{max,Burst} = 7*(12V - 2V) / 3kΩ + 6*12V / 1kΩ = @{format( (7*(12 - 2) / 3000 + 6*12 / 1000) * 1000, 3)}mA\nI_{max,Cont} = 7*(12V - 2V) / 3kΩ + 6*12V / 11kΩ = @{format( (7*(12 - 2) / 3000 + 6*12 / 11000) * 1000, 3)}mA\n\nmax Burst PD = R_{DS(on)} * I_{max,Burst}^{2} = @{format( 0.08 * (7*(12 - 2) / 3000 + 6*12 / 1000)^2 * 1000, 3)}mW @ R_{DS(on)}=80mΩ\nmax Cont. PD = R_{DS(on)} * I_{max,Cont}^{2} = @{format( 0.08 * (7*(12 - 2) / 3000 + 6*12 / 11000)^2 * 1000, 3)}mW @ R_{DS(on)}=80mΩ\n"
		(exclude_from_sim no)
		(at 24.892 82.296 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "28077056-f217-4f99-ad68-0175322fff1a")
	)
