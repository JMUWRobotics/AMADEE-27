	)
	(text "Singal Describtion:\n\n- ~{P1} and ~{P2}: Power relais (-Q4G7 & -Q4G8)\n	=> HIGH = Contacts opend and bus unpowered\n	=> HiZ = Contacts closed and bus powered\n\n- WD: Watchdog relais (-K5E13)\n	=> HIGH = Watchdog tripped and Load bus unpowered\n	=> HiZ = All OK and Load bus powered\n\n- E-STOP: (Emergency-) Stop button\n	=> HIGH = Stop button pressed\n	=> HiZ = Stop button not pressed\n\n- ~{EN}_{L}: ~{Enable}/Bypass static logic control\n	=> HIGH = directly forward Rapsberry commands bypassing Logic\n	=> LOW = enable Hardware Logic"
		(exclude_from_sim no)
		(at 20.32 18.288 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7adba61c-4664-48e3-8b6f-9f929233e194")
	)
