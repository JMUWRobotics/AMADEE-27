	(text_box "Note:\nAll the CD4xxx family ICs register a high-level as low as -3V below 12V.\nTherefor OR-ing together signals via diodes can be achieved as long as the accumulated voltage drop along a signal is less than the 3V minus a safty margin.\nWith Schottky diods of V_{F} of about 0.7V a line can handle up to:\n\n(3V - margin) / V_{F} = (3V - 0.5V) / V_{F} = @{format((3 - 0.5) / 0.7, 3)} >= @{floor((3 - 0.5) / 0.7)} diodes in series"
		(exclude_from_sim no)
		(at 199.39 30.48 0)
		(size 80.01 18.2607)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c7c7cf30-70e3-44e9-aa30-1ef6c8d2f86a")
	)
