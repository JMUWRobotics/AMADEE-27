	(text "max PD = R_{DS(on)} * (0.043A)^{2} = @{format(2 * 0.043^2 * 1000, 0)}mW @ R_{DS(on)}=2Ω\nmax R_{DS(on)} = 200mW / (50mA)^{2} = @{format(0.2 / (0.05)^2, 0)}Ω"
		(exclude_from_sim no)
		(at 145.796 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d4bbcaaa-efec-4a79-8ea4-824903af09b4")
	)
	(text_box "Both Sink connections/wires (Continous and Blinking) \nare internally protected against reverse currentflow and therefor dont impose a risk of short circuits when connected together.\n\nThe Continously on Sink overrules the Blinking Sink in the case that both are connected to an LED at the same time.\n\n\nStack light voltages:\nContinous	| C	| 0.666 V\nBlinking	| B	| 0.666 V\n        	|	| (1.75  V  +-0.10 V)?\nRed line	| R	| 9.55  V  +-0.05 V\nYellow line	| Y	| 8.80  V  +-0.05 V\nGreen line	| G	| 7.52  V  +-0.03 V\n\n\nStack light currents:\nI_{CR} = 40 mA  +-3 mA\nI_{CY} = 31 mA  +-4 mA\nI_{CG} = 12 mA  +-3 mA\n"
		(exclude_from_sim no)
		(at 45.72 61.2806 0)
		(size 55.88 49.2094)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bb4ccf84-8513-4fa4-8e8f-6ff72354f400")
	)
